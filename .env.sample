# Copy to .env (or .env.local) and fill in:  cp .env.sample .env
# Both files are gitignored; Next.js loads them on startup.

# Jev API key (TypeSafe). Get one at https://typesafe.ai
TYPESAFE_API_KEY=

# Python interpreter for the Jev bridge (default: .venv/bin/python)
# JEV_PYTHON=

# Auth provider for the demo pages: mock (default), logingov, idme
# NEXT_PUBLIC_AUTH_PROVIDER=mock
